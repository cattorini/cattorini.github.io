{
  "name": "cattorini-tests",
  "version": "1.0.0",
  "description": "Suite de tests Playwright para Cattorini",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:landing": "playwright test --grep @landing",
    "test:tienda": "playwright test --grep @tienda",
    "test:portal": "playwright test --grep @portal",
    "test:pedidos": "playwright test --grep @pedidos",
    "test:seguimiento": "playwright test --grep @seguimiento",
    "test:checkout": "playwright test --grep @checkout",
    "test:mayorista": "playwright test --grep @mayorista",
    "test:minorista": "playwright test --grep @minorista",
    "test:critical": "playwright test --grep @critical",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "test:rules": "node rules/run.mjs",
    "test:rules:objetivo": "node rules/run.mjs rules/reference/firestore.rules.objetivo",
    "test:existente": "playwright test --grep-invert \"@seguridad|@regresion\"",
    "test:regresion": "playwright test --grep @regresion",
    "test:seguridad": "playwright test --grep @seguridad",
    "test:legal": "playwright test --grep @legal",
    "test:unit": "node --test --test-reporter=spec unit/sw.test.mjs",
    "test:datos": "node --test --test-reporter=spec unit/catalogo-real.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^20.0.0",
    "firebase": "^11.10.0",
    "typescript": "^5.3.0"
  }
}
